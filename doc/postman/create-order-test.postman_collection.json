						"exec": [
							"const responseBody = pm.response.json();\r",
							"pm.collectionVariables.set(\"user-id\", responseBody.id);\r",
							"\r",
							"pm.test(\"Response status code is 200\", function () {\r",
							"    pm.expect(pm.response.code).to.equal(200);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Response has required fields\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"\r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData).to.have.all.keys('id', 'firstName', 'lastName', 'gender', 'birthDate', 'createdAt', 'modifiedAt');\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Gender must be a boolean value\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"\r",
							"    pm.expect(responseData).to.have.property('gender').that.is.a('boolean');\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Response time is less than 1sec\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Validate createdAt and modifiedAt fields are in a valid date format or null\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"\r",
							"    pm.expect(responseData).to.have.property('createdAt').that.satisfies(value => value === null || !isNaN(new Date(value).getTime()), \"createdAt must be a valid date or null\");\r",
							"    pm.expect(responseData).to.have.property('modifiedAt').that.satisfies(value => value === null || !isNaN(new Date(value).getTime()), \"modifiedAt must be a valid date or null\");\r",
							"});\r",
							""
